# Great Waters — Environment Variables Template
# Copy this file to .env and provide your secret values.

# Django Security
DJANGO_SECRET_KEY=django-insecure-great-waters-change-me-in-production-random-key-64chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_NAME=great_waters_db
DB_USER=pramodgopinath
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

# JWT Settings
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# CORS & Host Origins
CORS_ALLOW_ALL=True

# Email Notifications (Console backend for dev, SMTP for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Great Waters Notifications <notifications@greatwaters.com>

# Firebase Cloud Messaging
FCM_SERVER_KEY=mock-fcm-server-key-for-development

# Auto-logout (minutes of inactivity on the web portal)
SESSION_IDLE_TIMEOUT_MINUTES=30
PORTAL_BASE_URL=http://localhost:8000

# Leave rules: weekly-off days excluded from leave counts (Mon=0..Sun=6), e.g. 5,6
LEAVE_WEEKEND_DAYS=
APPROVAL_REMINDER_DAYS=2

# SMTP (production)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Expo push notifications (optional access token from expo.dev)
PUSH_NOTIFICATIONS_ENABLED=True
EXPO_ACCESS_TOKEN=
